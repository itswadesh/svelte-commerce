# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values for the backend you actually run:
#
#   cp .env.example .env
#
# Only ONE backend block should be active at a time, and it must match the
# connector exported from kitcommerce.config.ts (and installed in package.json).
# Everything below the backend blocks applies to every backend.
#
# Under `vite dev` / `vite preview` these are read from .env. A production Node
# build (`npm start`) and Docker read PUBLIC_* from the real process environment
# instead — set them on your deploy platform, not in a shipped .env.
# ---------------------------------------------------------------------------


# ===========================================================================
# Backend — pick one
# ===========================================================================

# --- Litekart (default) ----------------------------------------------------
PUBLIC_LITEKART_API_URL='https://api.litekart.in'
PUBLIC_LITEKART_DOMAIN='arialshop.com'
# Store to serve when the domain can't be resolved to one (required in Docker/production).
# PUBLIC_LITEKART_STORE_ID=''

# --- Medusa ----------------------------------------------------------------
# See docs/MEDUSA.md. Also switch kitcommerce.config.ts to
# `export * as services from './src/lib/core/connectors/medusa'`.
# PUBLIC_MEDUSA_API_URL='https://next.medusajs.com'
# PUBLIC_MEDUSA_PUBLISHABLE_API_KEY=''
# PUBLIC_MEDUSA_REGION_ID=''

# --- Vendure ---------------------------------------------------------------
# See docs/VENDURE.md. Also switch kitcommerce.config.ts to
# `export * as services from './src/lib/core/connectors/vendure'`.
# PUBLIC_VENDURE_API_URL='http://localhost:3000'

# --- Saleor ----------------------------------------------------------------
# See docs/SALEOR.md. Also switch kitcommerce.config.ts to
# `export * as services from './src/lib/core/connectors/saleor'`.
# PUBLIC_SALEOR_API_URL='https://store.saleor.cloud/graphql/'

# --- Bagisto ---------------------------------------------------------------
# Base URL the /proxy/bagisto/* route forwards to.
# PUBLIC_BAGISTO_API_URL='https://demo.bagisto.com'


# ===========================================================================
# Storefront
# ===========================================================================

# Active theme. Used by backends that serve no theme data; a store record from
# the API overrides it. One of: default, wine, organic, lime, noor.
PUBLIC_STOREFRONT_THEME='default'

# Login identifier the auth UI accepts, when the store record doesn't set one.
# One of: EMAIL, PHONE, BOTH.
# PUBLIC_LOGIN_TYPE='EMAIL'

# Shows demo credentials in the login modal. Leave unset outside demo deploys.
# PUBLIC_IS_DEMO_MODE='true'


# ===========================================================================
# Sitemap
# ===========================================================================

# Base URL /sitemap.xml resolves the store's sitemap path against. Without it,
# the route falls back to the S3 bucket below.
PUBLIC_SITEMAP_URL='https://pub-3.r2.dev'

# Private — only used to build the sitemap fallback URL when PUBLIC_SITEMAP_URL is unset.
# S3_BUCKET_NAME=''
# S3_REGION=''


# ===========================================================================
# Integrations (optional)
# ===========================================================================

# Klaviyo. The store's plugin settings take precedence over these.
# PUBLIC_KLAVIYO_COMPANY_ID=''
# PUBLIC_KLAVIYO_LIST_ID=''
