# PUBLIC_DJANGO_OSCAR_API_URL=''

# --- EverShop --------------------------------------------------------------
# @misiki/evershop-connector · docs/EVERSHOP.md
# PUBLIC_EVERSHOP_API_URL=''

# --- Magento Open Source ---------------------------------------------------
# @misiki/magento-connector · docs/MAGENTO.md
# PUBLIC_MAGENTO_API_URL=''

# --- nopCommerce -----------------------------------------------------------
# @misiki/nopcommerce-connector · docs/NOPCOMMERCE.md
# PUBLIC_NOPCOMMERCE_API_URL=''

# --- OpenCart --------------------------------------------------------------
# @misiki/opencart-connector · docs/OPENCART.md
# PUBLIC_OPENCART_API_URL=''

# --- OroCommerce -----------------------------------------------------------
