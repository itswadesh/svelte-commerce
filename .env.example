# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values for the backend you actually run:
#
#   cp .env.example .env
#
# Only ONE backend block should be active at a time, and it must match the
# connector exported from kitcommerce.config.ts (and installed in package.json).
# Everything below the backend blocks applies to every backend.
#
# Under `vite dev` / `vite preview` these are read from .env. A production Node
# build (`npm start`) and Docker read PUBLIC_* from the real process environment
# instead — set them on your deploy platform, not in a shipped .env.
# ---------------------------------------------------------------------------


# ===========================================================================
# Backend — pick one · wired end to end
#
# These five have an override module in src/lib/core/connectors and a branch in
# src/lib/core/connectors/init.ts, so the env below is all they need. init.ts
# throws when one of these is set while a different connector is active, so
# keep exactly one block uncommented.
# ===========================================================================

# --- Litekart (default) ----------------------------------------------------
# @misiki/litekart-connector · docs/LITEKART.md
# kitcommerce.config.ts: './src/lib/core/connectors/litekart'
PUBLIC_LITEKART_API_URL='https://api.litekart.in'
PUBLIC_LITEKART_DOMAIN='arialshop.com'
# Store to serve when the domain can't be resolved to one (required in Docker/production).
# PUBLIC_LITEKART_STORE_ID=''

# --- Medusa ----------------------------------------------------------------
# @misiki/medusa-connector · docs/MEDUSA.md
# kitcommerce.config.ts: './src/lib/core/connectors/medusa'
# PUBLIC_MEDUSA_API_URL='https://next.medusajs.com'
# PUBLIC_MEDUSA_PUBLISHABLE_API_KEY=''
# PUBLIC_MEDUSA_REGION_ID=''

# --- Vendure ---------------------------------------------------------------
# @misiki/vendure-connector · docs/VENDURE.md
# kitcommerce.config.ts: './src/lib/core/connectors/vendure'
# The GraphQL endpoint is resolved as <PUBLIC_VENDURE_API_URL>/shop-api.
# PUBLIC_VENDURE_API_URL='http://localhost:3000'

# --- Saleor ----------------------------------------------------------------
# @misiki/saleor-connector · docs/SALEOR.md
# kitcommerce.config.ts: './src/lib/core/connectors/saleor'
# PUBLIC_SALEOR_API_URL='https://store.saleor.cloud/graphql/'

# --- GoCommerce ------------------------------------------------------------
# @misiki/gocommerce-connector · docs/GOCOMMERCE.md
# kitcommerce.config.ts: './src/lib/core/connectors/gocommerce'
# The browser never calls this URL directly — GoCommerce sends no CORS headers,
# so /proxy/gocommerce/* forwards to it. The storefront SERVER must reach it.
# PUBLIC_GOCOMMERCE_API_URL='http://127.0.0.1:8080'


# ===========================================================================
# Backend — the other 22 connectors
#
# Each ships as a package, and kitcommerce.config.ts points straight at it
# (`export * as services from '@misiki/<platform>-connector'`) because none has
# an override module yet. src/lib/core/connectors/init.ts has NO branch for the
# variables below — it reads only the GoCommerce, Medusa, Saleor and Vendure ones — so
# setting one on its own does nothing yet. Add a branch following those three,
# applying whichever statics your connector exposes on its BaseService; each
# platform guide spells this out. The names below are the ones those guides use.
# ===========================================================================

# --- Bagisto ---------------------------------------------------------------
# @misiki/bagisto-connector · docs/BAGISTO.md
# Already read by the /proxy/bagisto/* route, which forwards to this base URL.
# PUBLIC_BAGISTO_API_URL='https://demo.bagisto.com'

# --- Broadleaf Commerce ----------------------------------------------------
# @misiki/broadleaf-connector · docs/BROADLEAF.md
# PUBLIC_BROADLEAF_API_URL=''

# --- commercetools ---------------------------------------------------------
# @misiki/commercetools-connector · docs/COMMERCETOOLS.md
# PUBLIC_COMMERCETOOLS_API_URL=''

# --- CS-Cart ---------------------------------------------------------------
# @misiki/cs-cart-connector · docs/CS-CART.md
# PUBLIC_CS_CART_API_URL=''

# --- Django Oscar ----------------------------------------------------------
