# ===========================================================================
# Storefront
# ===========================================================================

# Active theme. Used by backends that serve no theme data; a store record from
# the API overrides it. One of: default, wine, organic, lime, noor.
# PUBLIC_THEME and PUBLIC_ACTIVE_THEME are read as fallbacks, in that order.
PUBLIC_STOREFRONT_THEME='default'

# Login identifier the auth UI accepts, when the store record doesn't set one.
# One of: EMAIL, PHONE, BOTH.
# PUBLIC_LOGIN_TYPE='EMAIL'

# Shows demo credentials in the login modal. Leave unset outside demo deploys.
# PUBLIC_IS_DEMO_MODE='true'


# ===========================================================================
# Sitemap
# ===========================================================================

# Base URL /sitemap.xml resolves the store's sitemap path against. Without it,
# the route falls back to the S3 bucket below.
PUBLIC_SITEMAP_URL='https://pub-3.r2.dev'

# Private — only used to build the sitemap fallback URL when PUBLIC_SITEMAP_URL is unset.
# S3_BUCKET_NAME=''
# S3_REGION=''


# ===========================================================================
# Integrations (optional)
# ===========================================================================

# Klaviyo. The store's plugin settings take precedence over these.
# PUBLIC_KLAVIYO_COMPANY_ID=''
# PUBLIC_KLAVIYO_LIST_ID=''
